# ── Data files — do not push (CC-BY-NC-4.0, large) ──────────────────────
data/
*.csv
*.parquet
*.arrow

# Blanket-ignore JSON, then re-admit project artifacts below.
# Without the exceptions, the taxonomy and label files silently go untracked.
*.json
!misconception_taxonomy_v1.json
!stage1b_pilot_results.json
!stage1b_multilabel_verdict.json
!stage2_results.json
!requirements*.json

# Labeling output and checkpoints are large and regenerable — keep them out.
misconception_labels_v1.json
stage1b_full_labels*.json
stage1b_labels_checkpoint.json

# Trained weights (regenerable from notebook 06)
*.pt
*.pth

# ── HuggingFace cache ───────────────────────────────────────────────────
.cache/
~/.cache/huggingface/

# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.env
.venv/
env/

# ── Jupyter ─────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.nbconvert.*

# ── OS ──────────────────────────────────────────────────────────────────
.DS_Store
